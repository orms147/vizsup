# env / secrets
.env
.env.local
*.cookies.txt
cookies.txt
# browser-extension exports are named e.g. www.douyin.com_cookies.txt
*cookies*.txt

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# model caches / weights
models/
*.pt
*.onnx
*.ckpt
.cache/

# job working data & outputs
storage/
# Source clips are copyrighted (Douyin/Bilibili) and large — never commit them.
# The hand-labeled / generated REFERENCE SRTs are text-only and are committed, so
# the eval scripts in backend/scripts/ are reproducible. Media is regenerated with
# backend/scripts/make_fixtures.py.
samples/*
!samples/.gitkeep
# Design mock-ups: frames cut from real (copyrighted) Douyin videos stay local —
# regenerate with appdesign/v2/build_assets.py. Only the frame-free Settings shots
# are committed.
appdesign/v2/assets/*.jpg
appdesign/v2/screenshots/*
!appdesign/v2/screenshots/*-settings.jpg
!samples/refs/
samples/refs/*
!samples/refs/*.srt

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# agent worktrees (Claude Code subagents)
.claude/worktrees/

# the double-click app built by build-app.ps1 (make app)
/vizsup.exe
